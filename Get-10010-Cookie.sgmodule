#!name=联通Cookie获取
#!desc=打开联通手机营业厅APP，点击流量即可获取Cookie，抓到后把下面两项填 # 禁用
#!arguments=禁用脚本:获取联通Cookie,禁用MITM:hostname
#!arguments-desc=禁用脚本：禁用获取Cookie脚本，输入 # 表示禁用。\n\n禁用MITM：禁用MITM主机名，输入 # 表示禁用。

[Script]
{{{禁用脚本}}} = type=http-request,pattern=https:\/\/m(?:xx)?\.client\.10010\.com\/(?:.*\/)?smartwisdomCommon(?:New)?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/dompling/Script/master/10010/index.js,script-update-interval=0,binary-body-mode=0

[MITM]
{{{禁用MITM}}} = %APPEND% m.client.10010.com, mxx.client.10010.com