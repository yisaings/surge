联通神券 = type=http-response, pattern=^https://m\.client\.10010\.com/clientMyPage/v1/api/aggregateFloorData, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/10010/10010NoAds.js


[Rule]
DOMAIN,smartad.10010.com,REJECT
DOMAIN,m1.ad.10010.com,REJECT


[MITM]
