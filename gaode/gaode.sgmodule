#!name=高德精简
#!desc=只留地图与导航，去营销与推荐流
#!category=【yisa】Sgmodule
[Script]
高德场景推荐 = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/scene/recommend,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德推荐流 = type=http-response,pattern=^https://m5\.amap\.com/ws/info_bff/contentFeed,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德内容中心 = type=http-response,pattern=^https://m5\.amap\.com/ws/info_bff/ContentCenter,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德探索搜索 = type=http-response,pattern=^https://m5\.amap\.com/ws/c3frontend/af-ai-search/search,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德我的页 = type=http-response,pattern=^https://m5\.amap\.com/ws/shield/dsp/profile/index/nodefaasv3,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德地图图层 = type=http-response,pattern=^https://m5\.amap\.com/ws/faas/amap-navigation/main-page-aiqs,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德推广后台 = type=http-response,pattern=^https://m5-zb\.amap\.com/ws/,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德探索AI流 = type=http-response,pattern=^https://ai\.amap\.com/v1/ai_rec/home_explore,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
高德首页AI流 = type=http-response,pattern=^https://ai\.amap\.com/v1/ai_rec/home_qs,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/gaode/gaode-ad.js
[Rule]
DOMAIN,optimus-ads.amap.com,REJECT
[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, ai.amap.com
