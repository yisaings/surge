#!name=百度贴吧精简
#!desc=只留帖子查看，去视频、直播与广告
#!category=【yisa】Sgmodule
[Script]
tieba-feed = type=http-response,pattern=^https://tiebac\.baidu\.com/c/f/(excellent/personalized|frs/page|frs/threadlist),requires-body=true,binary-body-mode=true,max-size=-1,script-path=https://raw.githubusercontent.com/yisaings/surge/main/tieba/tieba-feed.js
tieba-shop = type=http-response,pattern=^https://tieba[c]?\.baidu\.com/c/f/frs/frsBottom,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/tieba/tieba-shop.js
tieba-album = type=http-response,pattern=^https://tieba\.baidu\.com/c/f/forum/getForumAlbum,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/tieba/tieba-album.js
tieba-profile = type=http-response,pattern=^https://tiebac\.baidu\.com/c/u/user/profile,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/tieba/tieba-profile.js
tieba-sync = type=http-response,pattern=^https://tiebac\.baidu\.com/c/s/sync,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/tieba/tieba-sync.js
tieba-splash = type=http-request,pattern=^https://tiebac\.baidu\.com/c/f/ad/getSplashAd,requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/tieba/tieba-splash.js
[URL Rewrite]
^https://tiebac\.baidu\.com/c/f/ad/getFeedAd _ reject
^https://tiebac\.baidu\.com/c/s/adNewLog _ reject
^https://tiebac\.baidu\.com/c/s/newlog _ reject
^https://tiebac\.baidu\.com/c/s/pv _ reject
^https://tiebac\.baidu\.com/c/s/nps/global _ reject
^https://tiebac\.baidu\.com/c/s/getIconToast _ reject
^https://tiebac\.baidu\.com/c/s/shop/getKjsIMList _ reject
^https://tiebac\.baidu\.com/c/s/activateTask _ reject
^https://tiebac\.baidu\.com/c/s/trackConfig _ reject
^https://tiebac\.baidu\.com/c/f/video/redIcon _ reject
^https://tiebac\.baidu\.com/c/f/voiceroom/newstab _ reject
^https://tiebac\.baidu\.com/c/f/chat/commonChannel _ reject
^https://tiebac\.baidu\.com/c/f/chat/getRoomListByFid _ reject
^https://tiebac\.baidu\.com/c/u/chat/getChatSubscriptionList _ reject
^https://tiebac\.baidu\.com/c/c/forum/statClientStartTimes _ reject
^https://tieba[c]?\.baidu\.com/c/f/forum/shopGoodsFeed _ reject
^https://tieba\.baidu\.com/mo/q/hybrid-main-forumtab/forumShopStreet/hybrid _ reject
^https://gsp0\.baidu\.com/.*/tb/img/track\.gif _ reject
^https://tiebac\.baidu\.com/livefeed/feed _ reject
^http://tiebac\.baidu\.com/c/s/interactMsgAlter _ reject
^http://[0-9.]+/album/ _ reject
[Rule]
DOMAIN,tiebapic.baidu.com,DIRECT
DOMAIN,tb.himg.baidu.com,DIRECT
DOMAIN,tb1.bdstatic.com,DIRECT
DOMAIN,tb3.bdstatic.com,DIRECT
DOMAIN,tbcdn.bdstatic.com,DIRECT
