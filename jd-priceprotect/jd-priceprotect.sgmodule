#!name=京东一键价保
#!desc=每天自动跑一次一键价保，有差价就通知返款金额。
#!category=【yisa】Sgmodule
[Script]
京东价保抓Cookie = type=http-request, pattern=^https://api\.m\.jd\.com/client\.action, script-path=https://raw.githubusercontent.com/yisaings/surge/main/jd-priceprotect/jd-cookie.js
京东一键价保 = type=cron, cronexp=0 9 * * *, script-path=https://raw.githubusercontent.com/yisaings/surge/main/jd-priceprotect/jd-priceprotect.js
[MITM]
hostname = %APPEND% api.m.jd.com
