#!name=什么值得买去红包
#!desc=去掉首页天天领红包卡、好价横幅红包卡与轮播横幅、详情页京东红包链接与红包小助手、好价顶栏领券/外卖红包入口与今日好券横幅、我的页大横幅与精选活动，只留正常内容。
#!category=【yisa】Sgmodule
[Script]
smzdm-home = type=http-response, pattern=^https://homepage-api\.smzdm\.com/v3/home, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/smzdm/smzdm-ad.js
smzdm-haojia-list = type=http-response, pattern=^https://haojia-api\.smzdm\.com/home/list, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/smzdm/smzdm-ad.js
smzdm-preload = type=http-response, pattern=^https://haojia-cdn\.smzdm\.com/preload/, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/smzdm/smzdm-ad.js
smzdm-detail = type=http-response, pattern=^https://haojia-api\.smzdm\.com/detail/, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/smzdm/smzdm-ad.js
smzdm-detail-related = type=http-response, pattern=^https://haojia\.m\.smzdm\.com/detail_modul/user_related_modul, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/smzdm/smzdm-ad.js
smzdm-vip = type=http-response, pattern=^https://user-api\.smzdm\.com/vip, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/smzdm/smzdm-ad.js
[MITM]
hostname = %APPEND% homepage-api.smzdm.com, haojia-api.smzdm.com, haojia-cdn.smzdm.com, haojia.m.smzdm.com, user-api.smzdm.com
