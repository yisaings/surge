
#!name=延长不背单词本地VIP时间
#!desc=修改用户信息接口，将所有VIP特权的有效期延长至2099年（仅对纯本地控制的功能有效）
#!author=yisaings
#!category=【yisa】不背单词

[Script]
# 拦截获取用户分类及VIP状态的接口
延长VIP时间 = type=http-response, pattern=^https?:\/\/learnywhere\.cn\/api\/activity\/common\/bb-user-category, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/yisaings/surge/refs/heads/main/bbdc/bbdc.js
[MITM]
# 开启该域名的 HTTPS 解密
hostname = %APPEND% learnywhere.cn
