#!name=WPS去推广
#!desc=去推广，前端显示会员。
#!category=Sgmodule

[Script]
去推广 = type=http-response,pattern=^https://tiance\.wps\.cn/dce/exec/api/(market/activity|resource/display|precise/activity),script-path=https://raw.githubusercontent.com/yisaings/surge/main/wps/wps-promo.js,requires-body=true
会员显示 = type=http-response,pattern=^https://account\.wps\.cn/api/v3/mine/vips,script-path=https://raw.githubusercontent.com/yisaings/surge/main/wps/wps-vip.js,requires-body=true
会员显示2 = type=http-response,pattern=^https://drive\.wps\.cn/api/v3/userinfo,script-path=https://raw.githubusercontent.com/yisaings/surge/main/wps/wps-vip.js,requires-body=true

[MITM]
hostname = %APPEND% tiance.wps.cn, account.wps.cn, drive.wps.cn
