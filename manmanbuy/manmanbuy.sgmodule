#!name=慢慢买去红包弹窗
#!desc=去红包卡与首页弹窗，只留正常内容
#!category=【yisa】Sgmodule
[Script]
慢慢买红包配置 = type=http-response, pattern=^https://apapia-common\.manmanbuy\.com/v1/config/getAppConfigRn, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/manmanbuy/manmanbuy-ad.js
慢慢买折扣页红包 = type=http-response, pattern=^https://apapia-sqk-weblogic\.manmanbuy\.com/activity/api/hb, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/manmanbuy/manmanbuy-ad.js
慢慢买首页悬浮层 = type=http-response, pattern=^https://apapia-sqk-weblogic\.manmanbuy\.com/v1/homeOverlay/getHomeOverlayInfo, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/manmanbuy/manmanbuy-ad.js
慢慢买首页弹窗 = type=http-response, pattern=^https://apapia-common\.manmanbuy\.com/v1/config, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/manmanbuy/manmanbuy-ad.js
[MITM]
hostname = %APPEND% apapia-common.manmanbuy.com, apapia-sqk-weblogic.manmanbuy.com
