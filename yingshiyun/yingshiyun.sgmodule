#!name=萤石云视频精简
#!desc=萤石云视频 VideoGo：首页天气不显示，服务专区清空，云存储卡片去掉，对话/社区内容清空、商城页空白，我的界面只留管理中心、服务中心、工具。底部对话/商城/社区三个按钮是 App 原生写死的，脚本删不掉按钮，只能掏空内容。
#!category=【yisa】Sgmodule

[Script]
EZVIZ天气空白 = type=http-response,pattern=^https://api\.ys7\.com/v3/weather/,script-path=https://raw.githubusercontent.com/yisaings/surge/refs/heads/main/yingshiyun/yingshiyun-ad.js,requires-body=1
