EZVIZ商城瀑布流清空 = type=http-response,pattern=^https://m\.ys7\.com/default/index-waterfall-tab-list,script-path=https://raw.githubusercontent.com/yisaings/surge/refs/heads/main/yingshiyun/yingshiyun-ad.js,requires-body=1
EZVIZ商城页空白 = type=http-response,pattern=^https://m\.ys7\.com/default/rn-index,script-path=https://raw.githubusercontent.com/yisaings/surge/refs/heads/main/yingshiyun/yingshiyun-ad.js,requires-body=1
