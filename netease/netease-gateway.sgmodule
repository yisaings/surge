#!name=网易云畅听
#!desc=畅听 VIP 歌曲。
#!category=Sgmodule
#!arguments=TOKEN:口令,NAME:备注
#!arguments-desc=TOKEN:填入专属口令\nNAME:填设备备注，如张三的手机，不填留空\n\n
[Script]
歌曲播放与详情 = type=http-request,pattern=^https?:\/\/interface\d?\.music\.163\.com\/x?eapi\/(?:v\d+\/)?song\/(?!(?:like|dislike)),requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/netease/netease-gateway-client-redirect-1794142620.js,argument={{{TOKEN}}}
歌单详情 = type=http-request,pattern=^https?:\/\/interface\d?\.music\.163\.com\/w?x?e?api\/(?:homepage\/|v\d+\/)?playlist\/(?!(?:delete|subscribe|unsubscribe|create|update|manipulate|tracks)),requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/netease/netease-gateway-client-redirect-1794142620.js,argument={{{TOKEN}}}
VIP与音质鉴权 = type=http-request,pattern=^https?:\/\/interface\d?\.music\.163\.com\/x?eapi\/(?:vipnewcenter|vipauth|music\/privilege|soundquality|song\/enhance\/privilege|v\d+\/user\/vip|user\/setting),requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/netease/netease-gateway-client-redirect-1794142620.js,argument={{{TOKEN}}}
皮肤与装扮 = type=http-request,pattern=^https?:\/\/interface\d?\.music\.163\.com\/x?eapi\/(?:playermode|vip-dress|dress|usertool),requires-body=true,script-path=https://raw.githubusercontent.com/yisaings/surge/main/netease/netease-gateway-client-redirect-1794142620.js,argument={{{TOKEN}}}
网易云页面净化 = type=http-response,pattern=^https?:\/\/interface(\d+)?\.music\.163\.com\/x?e?api\/(v\d\/)?(link\/home\/framework\/(top\/)?tab|link\/page\/(rcmd|discovery)\/|homepage\/block\/page|discovery\/recommend\/resource|sp\/flow\/popup|vipactivity|link\/position\/show|batch),requires-body=true,binary-body-mode=true,max-size=3145728,script-path=https://raw.githubusercontent.com/yisaings/surge/main/netease/netease-clean-1794139322.js
[MITM]
hostname = %APPEND% interface.music.163.com, interface3.music.163.com
