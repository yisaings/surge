#!name=渝畅行精简
#!desc=只留乘车功能，去广告与动态流
#!category=【yisa】Sgmodule


[Script]
渝畅行首页菜单 = type=http-response, pattern=^https://ycx\.cqmetro\.cn/bas/appmgt/v3/app-menus, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/yuchangxing/yuchangxing-ad.js
渝畅行广告 = type=http-response, pattern=^https://api\.bwton\.com/bas/ad/v1/advertisement/getAds, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/yuchangxing/yuchangxing-ad.js
渝畅行首页动态 = type=http-response, pattern=^https://api\.bwton\.com/bas/tweets/v1/posts/home_list, requires-body=true, script-path=https://raw.githubusercontent.com/yisaings/surge/main/yuchangxing/yuchangxing-ad.js


[URL Rewrite]
^https://dlogs\.bwton\.com/ _ reject
^https://upload\.bwton\.com/applog/ _ reject
^https://sofire\.baidu\.com/ _ reject


[MITM]
hostname = %APPEND% ycx.cqmetro.cn, api.bwton.com
