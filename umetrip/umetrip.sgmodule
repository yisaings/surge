#!name=航旅纵横精简
#!desc=精简首页、我的页与社区，去推广营销
#!category=【yisa】Sgmodule
[Script]
umetrip-gw = type=http-response,pattern=^https?://(bkclient\.umetrip\.com\.cn|umerp\.umetrip\.com(\.cn)?|umehome\.umetrip\.com(\.cn)?|home\.umetrip\.com(\.cn)?|opactivity\.umetrip\.com|sns\.umetrip\.com)/gateway/api/umetrip/native,requires-body=true,binary-body-mode=true,max-size=1048576,script-path=https://raw.githubusercontent.com/yisaings/surge/main/umetrip/umetrip-gw.js
[URL Rewrite]
^https://sns\.umetrip\.com/weex/ _ reject
^https://activity\.umetrip\.com/ _ reject
^https://sensors\.umetrip\.com\.cn/ _ reject
^https://analytics\.umetrip\.com/ _ reject
^https://bda\.umetrip\.com/ _ reject
^https://lefox-data-library-cdn\.cdfsunrise.com/ _ reject
^https://oss\.umetrip\.com/fs/advert/polite/ _ reject
^https://api\.mixpanel\.com/ _ reject
[MITM]
hostname = %APPEND% sns.umetrip.com, activity.umetrip.com, sensors.umetrip.com.cn, analytics.umetrip.com, bda.umetrip.com, lefox-data-library-cdn.cdfsunrise.com, oss.umetrip.com, api.mixpanel.com, bkclient.umetrip.com.cn, umerp.umetrip.com, umehome.umetrip.com, home.umetrip.com, opactivity.umetrip.com
